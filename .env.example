# Environment Variables
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000

# OpenRouter — generation + multimodal extract
# Model vars must be deepseek/deepseek-v4-flash (approved paid) or any OpenRouter slug ending in :free
# (see lib/openrouter.ts). Embeddings are browser MiniLM (Xenova/all-MiniLM-L6-v2, 384-d), not OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_VISION_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_AUDIO_MODEL=deepseek/deepseek-v4-flash
# Legacy server-side extract path only; live client media uses VISION + AUDIO via /api/extract-media
OPENROUTER_TRANSCRIPTION_MODEL=deepseek/deepseek-v4-flash

# Supabase (database + auth + pgvector + storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
